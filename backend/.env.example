# Puerto HTTP del API
PORT=4000

# PostgreSQL (solo para la lista de espera)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nocaimatech?schema=public

# Origen(es) permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:5173

# Claude (nunca se expone al frontend)
ANTHROPIC_API_KEY=sk-ant-...
# Solo si la clave no está ligada a un workspace (sk-ant-usr-…): ID wrkspc_… de la consola
ANTHROPIC_WORKSPACE_ID=
MODEL_CHAT=claude-opus-5-5
# Esfuerzo del modelo: low | medium | high (vacío = valor por defecto del modelo)
CHAT_EFFORT=low
